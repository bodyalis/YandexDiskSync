{
    "name": "yandex-disk-sync",
    "version": "1.3.3",
    "description": "Two-way sync between your Obsidian vault and Yandex Disk via the official Disk REST API, with conflict handling, soft delete and dry-run.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "eslint \"src/**/*.ts\" && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" --fix",
        "version": "node version-bump.mjs && git add manifest.json versions.json"
    },
    "keywords": [
        "obsidian",
        "obsidian-plugin",
        "yandex",
        "yandex-disk",
        "webdav",
        "sync",
        "backup"
    ],
    "author": "Bogdan Listopad",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bodyalis/YandexDiskSync.git"
    },
    "bugs": {
        "url": "https://github.com/bodyalis/YandexDiskSync/issues"
    },
    "homepage": "https://github.com/bodyalis/YandexDiskSync#readme",
    "devDependencies": {
        "@types/node": "^16.11.29",
        "@typescript-eslint/parser": "^8.59.3",
        "builtin-modules": "^3.3.0",
        "esbuild": "0.17.3",
        "eslint": "^9.39.4",
        "eslint-plugin-obsidianmd": "^0.2.9",
        "obsidian": "^1.12.3",
        "tslib": "2.4.0",
        "typescript": "^5.9.3"
    }
}