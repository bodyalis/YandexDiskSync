{
    "name": "yandex-disk-sync",
    "version": "1.0.0",
    "description": "Two-way sync between your Obsidian vault and Yandex Disk via WebDAV, with conflict handling, soft delete and dry-run.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "version": "node version-bump.mjs && git add manifest.json versions.json"
    },
    "keywords": [
        "obsidian",
        "obsidian-plugin",
        "yandex",
        "yandex-disk",
        "webdav",
        "sync",
        "backup"
    ],
    "author": "Bogdan Listopad",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bodyalis/YandexDiskSync.git"
    },
    "bugs": {
        "url": "https://github.com/bodyalis/YandexDiskSync/issues"
    },
    "homepage": "https://github.com/bodyalis/YandexDiskSync#readme",
    "devDependencies": {
        "@types/node": "^16.11.29",
        "builtin-modules": "^3.3.0",
        "esbuild": "0.17.3",
        "obsidian": "^1.12.3",
        "tslib": "2.4.0",
        "typescript": "4.9.5"
    }
}